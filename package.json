{
  "name": "tunneldesk",
  "productName": "TunnelDesk",
  "version": "0.2.3",
  "description": "Cloudflare Zero Trust connection manager for Windows, Linux, and macOS",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build:renderer": "vite build",
    "dev": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --x64",
    "dist:linux": "npm run build:renderer && electron-builder --linux --x64",
    "dist:mac": "npm run build:renderer && electron-builder --mac"
  },
  "build": {
    "appId": "com.tunneldesk.app",
    "productName": "TunnelDesk",
    "copyright": "TunnelDesk",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "src/main/**/*.js",
      "src/preload.js",
      "assets/icon.png",
      "assets/icon.ico",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TunnelDesk",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network",
      "description": "Cloudflare Zero Trust connection manager"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "TunnelDesk",
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": true,
    "asarUnpack": []
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "keywords": [
    "electron",
    "cloudflare",
    "rdp",
    "ssh",
    "windows",
    "linux"
  ],
  "author": {
    "name": "TunnelDesk",
    "email": "hello@tym.wtf"
  },
  "license": "MIT"
}
